# Copy to .env and adjust. Never commit .env.

# --- Database (required) -------------------------------------------------
POSTGRES_DB=infrawatch
POSTGRES_USER=infrawatch
# Generate one with: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Web -------------------------------------------------------------------
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
# Session cookies are sent over HTTPS only. Browsers treat http://localhost as
# secure, so this works locally; set to false ONLY if you must reach the
# dashboard over plain HTTP from another machine (not recommended).
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
# The first account to register becomes admin. Later self-registration
# (as read-only viewers) is disabled unless this is true.
ALLOW_REGISTRATION=false
# Only needed if the dashboard is served from another origin.
CORS_ORIGINS=

# --- Monitoring --------------------------------------------------------------
AGENT_OFFLINE_AFTER_SECONDS=30
LOG_LEVEL=INFO

# --- Retention (see docs/retention.md) ----------------------------------------
RAW_RETENTION_HOURS=48
METRIC_RETENTION_DAYS=30
DAILY_RETENTION_DAYS=365
